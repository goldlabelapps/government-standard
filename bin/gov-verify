#!/usr/bin/env python3
"""
Government Standard - Operational Verification CLI
Enforces normative controls from standard/v0.2.0.md across local workspaces.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# Common high-risk secret patterns (Control GS-AI-DATA-02)
SECRET_PATTERNS = [
    (r"-----BEGIN (RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY-----", "Private cryptographic key"),
    (r"AKIA[0-9A-Z]{16}", "AWS Access Key ID"),
    (r"ghp_[0-9a-zA-Z]{36}", "GitHub Personal Access Token"),
    (r"github_pat_[0-9a-zA-Z_]{22,}", "GitHub Fine-Grained Personal Access Token"),
    (r"xox[baprs]-[0-9a-zA-Z]{10,48}", "Slack API Token"),
    (r"(?:api_key|apikey|secret_key)\s*[:=]\s*['\"][A-Za-z0-9_\-]{20,}['\"]", "High-entropy API key"),
    (r"(?:postgres|mysql|mongodb)://[^:]+:[^@]+@[^\s/]+", "Database connection string with credentials"),
]

IGNORED_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__", ".next", ".turbo"}
IGNORED_FILES = {"bin/gov-verify", ".DS_Store"}


def get_repo_root() -> Path:
    current = Path(__file__).resolve().parent
    while current != current.parent:
        if (current / ".git").exists() or (current / "standard").exists():
            return current
        current = current.parent
    return Path.cwd()


def scan_secrets(root: Path, staged_only: bool = False) -> list:
    findings = []
    files_to_scan = []

    if staged_only:
        try:
            out = subprocess.check_output(
                ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                cwd=root,
                text=True,
            )
            files_to_scan = [root / line.strip() for line in out.splitlines() if line.strip()]
        except Exception:
            files_to_scan = []
    else:
        for p in root.rglob("*"):
            if p.is_file():
                rel_parts = p.relative_to(root).parts
                if any(ignored in rel_parts for ignored in IGNORED_DIRS):
                    continue
                rel_str = str(p.relative_to(root))
                if rel_str in IGNORED_FILES:
                    continue
                files_to_scan.append(p)

    compiled_patterns = [(re.compile(pat, re.IGNORECASE), desc) for pat, desc in SECRET_PATTERNS]

    for file_path in files_to_scan:
        if not file_path.exists() or file_path.is_dir():
            continue
        # Skip binary files
        try:
            with open(file_path, "r", encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
        except Exception:
            continue

        rel_path = file_path.relative_to(root)
        for line_num, line in enumerate(lines, 1):
            # Skip documentation examples explicitly defining regex
            if "SECRET_PATTERNS" in line or "re.compile" in line:
                continue
            for pattern, desc in compiled_patterns:
                if pattern.search(line):
                    findings.append({
                        "file": str(rel_path),
                        "line": line_num,
                        "description": desc,
                        "snippet": line.strip()[:60] + "...",
                    })

    return findings


def check_links_and_assets(root: Path) -> list:
    findings = []
    md_files = [p for p in root.rglob("*.md") if not any(ignored in p.parts for ignored in IGNORED_DIRS)]
    
    # Matches markdown links [text](path) and HTML img tags
    md_link_pattern = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")
    html_img_pattern = re.compile(r"<img[^>]+src=[\"']([^\"']+)[\"']")

    for md_path in md_files:
        rel_md = md_path.relative_to(root)
        try:
            content = md_path.read_text(encoding="utf-8")
        except Exception as e:
            findings.append({"file": str(rel_md), "error": f"Could not read file: {e}"})
            continue

        # Check markdown links
        for text, target in md_link_pattern.findall(content):
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            clean_target = target.split("#")[0].strip()
            if not clean_target:
                continue
            resolved = (md_path.parent / clean_target).resolve()
            if not resolved.exists():
                findings.append({
                    "file": str(rel_md),
                    "link_text": text,
                    "target": target,
                    "resolved": str(resolved),
                    "error": "Target file or resource does not exist",
                })

        # Check HTML image tags
        for src in html_img_pattern.findall(content):
            if src.startswith(("http://", "https://", "data:")):
                continue
            clean_src = src.split("?")[0].strip()
            # If path starts with slash, treat relative to root
            if clean_src.startswith("/"):
                resolved = (root / clean_src.lstrip("/")).resolve()
            else:
                resolved = (md_path.parent / clean_src).resolve()
            if not resolved.exists():
                findings.append({
                    "file": str(rel_md),
                    "link_text": "HTML img src",
                    "target": src,
                    "resolved": str(resolved),
                    "error": "Image asset does not exist",
                })

    return findings


def evaluate_conformance(root: Path) -> dict:
    """Verifies baseline repository controls defined in Government Standard v0.2.0."""
    checks = [
        ("Canonical Agent Instructions (Control GS-AI-TOOL-01)", (root / "AGENTS.md").exists()),
        ("Versioned Standard Normative Spec", (root / "standard/v0.2.0.md").exists()),
        ("Threat Model and Risk Matrix", (root / "docs/threat-model.md").exists()),
        ("Conformance Checklist Evaluation Worksheet", (root / "docs/conformance-checklist.md").exists()),
        ("Frontend Verification Profile (WCAG 2.2 AA)", (root / "docs/verification/frontend.md").exists()),
        ("Backend & API Verification Profile", (root / "docs/verification/backend.md").exists()),
        ("DevOps & Platform Verification Profile", (root / "docs/verification/devops.md").exists()),
        ("Full-Stack Verification Profile", (root / "docs/verification/fullstack.md").exists()),
        ("Linux Execution Profile (MicroVM & Rootless)", (root / "docs/platforms/linux.md").exists()),
        ("macOS Execution Profile", (root / "docs/platforms/macos.md").exists()),
        ("Windows Execution Profile", (root / "docs/platforms/windows.md").exists()),
        ("Assets & Govmint Brand Kit", (root / "assets/govmint/logo.svg").exists()),
    ]
    
    results = []
    all_passed = True
    for name, passed in checks:
        if not passed:
            all_passed = False
        results.append({"name": name, "passed": passed})

    return {"passed": all_passed, "checks": results}


def main():
    parser = argparse.ArgumentParser(description="Government Standard Operational Verification CLI")
    parser.add_argument("--all", action="store_true", default=True, help="Run all verification checks")
    parser.add_argument("--secrets", action="store_true", help="Scan repository for hardcoded credentials and tokens")
    parser.add_argument("--links", action="store_true", help="Validate link and asset integrity across markdown files")
    parser.add_argument("--conformance", action="store_true", help="Evaluate conformance against Government Standard v0.2.0")
    parser.add_argument("--pre-commit", action="store_true", help="Run pre-commit checks on staged changes")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")

    args = parser.parse_args()
    root = get_repo_root()

    selected_secrets = args.secrets or args.pre_commit or (not args.links and not args.conformance)
    selected_links = args.links or args.pre_commit or (not args.secrets and not args.conformance)
    selected_conformance = args.conformance or (not args.secrets and not args.links and not args.pre_commit)

    telemetry = {
        "status": "PASS",
        "secret_findings": [],
        "link_findings": [],
        "conformance": {},
    }

    if selected_secrets:
        secret_findings = scan_secrets(root, staged_only=args.pre_commit)
        telemetry["secret_findings"] = secret_findings
        if secret_findings:
            telemetry["status"] = "FAIL"

    if selected_links:
        link_findings = check_links_and_assets(root)
        telemetry["link_findings"] = link_findings
        if link_findings:
            telemetry["status"] = "FAIL"

    if selected_conformance:
        conformance_res = evaluate_conformance(root)
        telemetry["conformance"] = conformance_res
        if not conformance_res["passed"]:
            telemetry["status"] = "FAIL"

    if args.json:
        print(json.dumps(telemetry, indent=2))
        sys.exit(0 if telemetry["status"] == "PASS" else 1)

    # Terminal output
    print("=" * 72)
    print("  GOVERNMENT STANDARD // OPERATIONAL VERIFICATION HARNESS")
    print(f"  Root: {root}")
    print("=" * 72)

    if selected_secrets:
        print("\n[*] SCANNING FOR UNPROTECTED SECRETS AND CREDENTIALS (C-07)...")
        if telemetry["secret_findings"]:
            print(f"[-] FAILED: Found {len(telemetry['secret_findings'])} potential credential leaks:")
            for item in telemetry["secret_findings"]:
                print(f"    - {item['file']}:{item['line']} [{item['description']}]")
        else:
            print("[+] PASSED: Zero unprotected secrets or high-entropy tokens detected.")

    if selected_links:
        print("\n[*] VERIFYING INTERNAL LINKS AND ASSET REFERENCES (C-16)...")
        if telemetry["link_findings"]:
            print(f"[-] FAILED: Found {len(telemetry['link_findings'])} broken references:")
            for item in telemetry["link_findings"]:
                print(f"    - In {item['file']}: [{item.get('link_text', 'ref')}]({item.get('target', '')})")
        else:
            print("[+] PASSED: All internal Markdown links and asset paths verified.")

    if selected_conformance:
        print("\n[*] EVALUATING REPOSITORY CONFORMANCE (v0.2.0 BASELINE)...")
        for check in telemetry["conformance"]["checks"]:
            status_str = "[OK]" if check["passed"] else "[MISSING]"
            print(f"  {status_str:9} {check['name']}")

    print("\n" + "=" * 72)
    if telemetry["status"] == "PASS":
        print("  RESULT: VERIFICATION PASSED (Zero security or integrity violations)")
        print("=" * 72)
        sys.exit(0)
    else:
        print("  RESULT: VERIFICATION FAILED (Review findings above)")
        print("=" * 72)
        sys.exit(1)


if __name__ == "__main__":
    main()
